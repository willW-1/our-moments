// Prisma schema for our-moments
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  @@map("users")
}

model Memory {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  date        DateTime
  location    String?
  description String?
  image_url   String?
  created_at  DateTime @default(now())

  @@map("memories")
}
